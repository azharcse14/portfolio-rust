# Copy this to `.env` for local dev. Production values are set via:
#   flyctl secrets set KEY=value
# on Fly.io (never committed to git).

# Where the SQLite file lives. The `?mode=rwc` flag lets sqlx create it
# on first run if missing.
DATABASE_URL=sqlite://portfolio.db?mode=rwc

# Sign admin JWTs. MUST be set in production. Generate a strong value:
#   openssl rand -hex 64
JWT_SECRET=change-me-in-production-use-openssl-rand-hex-64

# Bind address for the Axum server. cargo-leptos local dev uses 127.0.0.1:3000;
# Docker/Fly use 0.0.0.0:8080 (see fly.toml / Dockerfile).
# LEPTOS_SITE_ADDR=0.0.0.0:8080

# Tracing / log level. Use `debug` for verbose, `warn` for quiet.
RUST_LOG=info

# Optional: external services (Phase 4+ enhancements, not used yet)
# RESEND_API_KEY=
# CLOUDINARY_URL=
